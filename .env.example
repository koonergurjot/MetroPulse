# Free developer key: https://developer.translink.ca
TRANSLINK_API_KEY=

# Optional. Raises rate limits on the BC Address Geocoder.
BC_GEOCODER_API_KEY=

# Path or https URL to the baked stop index. See README.
STOP_INDEX_PATH=data/stops.sample.csv

# Request tuning
DEFAULT_RADIUS_M=800
MAX_RADIUS_M=2000
FANOUT_BUDGET_MS=6000
