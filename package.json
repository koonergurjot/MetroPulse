{
  "name": "metropulse",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dev:api": "node --experimental-strip-types scripts/dev-api.ts",
    "build:stops": "node --experimental-strip-types scripts/build-stops.ts",
    "verify:sources": "node --experimental-strip-types scripts/verify-sources.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "lucide-react": "^0.294.0",
    "maplibre-gl": "^6.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
